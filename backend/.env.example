# ===========================================================================
# VIDYORA AI - Backend Environment Configuration Example
# Copy this file to .env in backend/ or the project root and populate with your credentials.
# NEVER commit the real .env file or real API keys to version control.
# ===========================================================================

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Name
# Supported options: gemini-2.5-flash (recommended default), gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Backend Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO

# ===========================================================================
# PostgreSQL Persistence Configuration
# ===========================================================================
# Option 1: Full PostgreSQL connection URL (Recommended for production/CI)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/vidyora_ai

# Option 2: Individual connection parameters (Fallback if DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vidyora_ai
 
# ===========================================================================
# Authentication & JWT Configuration
# ===========================================================================
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_chars_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===========================================================================
# RAG & Embedding Configuration
# ===========================================================================
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# ===========================================================================
# Production Deployment & CORS
# ===========================================================================
FRONTEND_URL=https://vidyora-ai-frontend.onrender.com
ALLOWED_ORIGINS=https://vidyora-ai-frontend.onrender.com
